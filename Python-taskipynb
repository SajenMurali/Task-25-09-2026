    "def longs(student_ids):\n",
    "    seen=set()\n",
    "    left=0\n",
    "    max_length=0\n",
    "    for r in range(len(student_ids)):\n",
    "        while student_ids[r] in seen:\n",
    "            seen.remove(student_ids[left])\n",
    "            left+=1\n",
    "        seen.add(student_ids[r])\n",
    "        max_length=max(max_length,r - left + 1)\n",
    "    return max_length\n",
    "student_ids = list(map(int,input().split()))\n",
    "\n",
    "print(longs(student_ids))"
   ]
