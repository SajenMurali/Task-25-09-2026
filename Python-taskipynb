    "def longe(products):\n",
    "    seen=set()\n",
    "    left=0\n",
    "    max_length=0\n",
    "    for right in range(len(products)):\n",
    "        while products[right] in seen:\n",
    "            seen.remove(products[left])\n",
    "            left+=1\n",
    "        seen.add(products[right])\n",
    "        max_length=max(max_length,right-left+1)\n",
    "    return max_length\n",
    "products=list(map(int,input().split()))\n",
    "print(longe(products))"
