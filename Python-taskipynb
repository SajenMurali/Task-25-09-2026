    "    for i in range(len(arr)):\n",
    "        total = 0\n",
    "        for j in range(i, len(arr)):\n",
    "            total += arr[j]\n",
    "            if total == target:\n",
    "                count += 1\n",
    "    return count\n",
    "transactions = [1, 2, 3, -2, 2]\n",
    "target = 3\n",
    "print(count_subarrays(transactions, target))"
